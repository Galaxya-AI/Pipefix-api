# Copy to openshift/setup.env (never committed), fill in, then run ./openshift/setup.sh
# Access codes go in openshift/access-codes (never committed), one "name:code" per line.

REGISTRY_USERNAME=
REGISTRY_TOKEN=

GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
OPENAI_API_KEY=
API_TOKEN=
DRY_RUN=true
# Iterative remediation (with DRY_RUN=false or "apply": true): fix, wait for the pipeline, fix again
MAX_ROUNDS=5
WAIT_FOR_PIPELINE=true
PIPELINE_TIMEOUT_S=900
MAX_FIX_ATTEMPTS=2
MAX_CONTEXT_JOBS=5
CONTEXT_LOG_LINES=150
# Limits, not budgets: a round usually takes 5 to 10 LLM calls (journal event "llm_calls")
AGENT_MAX_TURNS=10
MAX_LLM_CALLS_PER_RUN=50
CONNECTORS=gitlab
SERPER_API_KEY=
TRIAGE_LLM_PROVIDER=openai
TRIAGE_LLM_MODEL=
DIAGNOSIS_LLM_PROVIDER=openai
DIAGNOSIS_LLM_MODEL=
RESEARCH_LLM_PROVIDER=openai
RESEARCH_LLM_MODEL=
FIXER_LLM_PROVIDER=openai
FIXER_LLM_MODEL=
REVIEWER_LLM_PROVIDER=openai
REVIEWER_LLM_MODEL=

# Web interface (pipefix-web) and visitors
# Address of the "Ask for an access code" link of the interface (empty: no link)
ACCESS_REQUEST_EMAIL=
# Addresses of the interface when it is on another domain, comma-separated (empty: same domain only)
CORS_ORIGINS=
MAX_PARALLEL_RUNS=2
DAILY_RUNS_PER_VISITOR=10
LLM_MIN_INTERVAL_S=0.5
# GitLab webhook "Pipeline events" (empty: webhook disabled)
GITLAB_WEBHOOK_SECRET=

PIPEFIX_HOST=pipefix.xulys.com
