# Copy this file to .env and fill in the values. Never commit .env.

# --- LLM providers (set the key of each provider you use) ---
# Provider names to use below: openai, ollama
OPENAI_API_KEY=
# Local OpenAI-format server, e.g. http://localhost:11434/v1
OLLAMA_BASE_URL=
LLM_TIMEOUT_S=
LLM_MAX_ATTEMPTS=
LLM_RETRY_BASE_DELAY_S=
# Minimum wait between two LLM calls of the whole pod, in seconds (default 0.5; 0: none)
LLM_MIN_INTERVAL_S=

# --- LLM of each agent (provider and model are required) ---
TRIAGE_LLM_PROVIDER=
TRIAGE_LLM_MODEL=
DIAGNOSIS_LLM_PROVIDER=
DIAGNOSIS_LLM_MODEL=
RESEARCH_LLM_PROVIDER=
RESEARCH_LLM_MODEL=
FIXER_LLM_PROVIDER=
FIXER_LLM_MODEL=
REVIEWER_LLM_PROVIDER=
REVIEWER_LLM_MODEL=

# Optional reasoning effort per OpenAI model (lower = cheaper), e.g. gpt-6.1-terra=low,gpt-6-luna=none
OPENAI_REASONING_EFFORT=

# --- Agent limits ---
AGENT_MAX_TURNS=
AGENT_MAX_INVALID_ANSWERS=
AGENT_MAX_SUB_AGENT_DEPTH=
MAX_LLM_CALLS_PER_RUN=
TOOL_MAX_OUTPUT_CHARS=
# Files given in full to the fixer and the reviewer (characters per file, number of files)
TASK_FILE_MAX_CHARS=
TASK_MAX_FILES=

# --- Connectors (comma-separated: gitlab, web_search) ---
CONNECTORS=
GITLAB_URL=
# read_api to analyse; api to publish merge requests
GITLAB_TOKEN=
# Serper API key (Google results, serper.dev), used by the research agent (web_search)
SERPER_API_KEY=
# JSON file listing the external MCP servers ({} = none); it must exist
MCP_SERVERS_FILE=config/mcp_servers.json
# Seconds before an MCP server that does not answer is stopped
MCP_TIMEOUT_S=
# Tokens used by config/mcp_servers.json as ${GITHUB_TOKEN}
GITHUB_TOKEN=

# --- Orchestration ---
# true: write the patch only; false: commit and open a draft merge request
DRY_RUN=
# Lint/format errors fixed by ruff itself before any agent (true by default); ruff time limit in seconds
AUTOFIX_RUFF=
RUFF_TIMEOUT_S=
# Reuse an approved fix for the same failure on the same commit (true by default), for this many seconds
REUSE_FIXES=
REUSE_TTL_S=
MAX_FIX_ATTEMPTS=
MAX_ROUNDS=
WAIT_FOR_PIPELINE=
PIPELINE_TIMEOUT_S=
AUTO_RETRY_FLAKY=
CONTEXT_LOG_LINES=
FIX_BRANCH_PREFIX=
RUNS_DIR=

# --- Notification when a pipeline is not fixed ---
NOTIFY_ON_FAILURE=
# Label of the GitLab issues opened by the system (one issue per failing branch)
FAILURE_ISSUE_LABEL=
# Slack or Teams incoming webhook URL (empty: no chat message)
CHAT_WEBHOOK_URL=

# --- Data policy ---
# Comma-separated projects (group/project or id) whose data must stay internal
CONFIDENTIAL_PROJECTS=
# Comma-separated glob patterns of files the agents may never read, e.g. src/pricing/**,**/*.pem
DENIED_PATHS=
# Comma-separated providers allowed for confidential projects, e.g. ollama
INTERNAL_LLM_PROVIDERS=

# --- Run queue (production: Redis + workers) ---
# Empty: runs work in threads of the API, at most MAX_PARALLEL_RUNS at once (default 2)
REDIS_URL=
MAX_PARALLEL_RUNS=
# Web analyses per access code and per day (default 10; 0: no limit)
DAILY_RUNS_PER_VISITOR=
# Important branches, processed first. Empty: the default and protected branches of each
# project, read in GitLab. Set (comma-separated glob patterns, e.g. release/*): replaces that rule.
PRIORITY_BRANCHES=
# Maximum duration of one run, and maximum wait for its branch (seconds)
RUN_TIMEOUT_S=
# Time during which the same pipeline is not queued again (seconds)
DEDUP_TTL_S=

# --- REST API (python app.py in development, gunicorn app:app in docker-compose.yml) ---
API_HOST=
API_PORT=
# Bearer token required on /api/v1 routes; empty = the API is disabled (the web page still works)
API_TOKEN=
# Gunicorn options read by docker-compose.yml: processes, threads per process, request timeout
GUNICORN_WORKERS=
GUNICORN_THREADS=
GUNICORN_TIMEOUT=
# Secret token of the GitLab webhook (empty: webhook disabled)
GITLAB_WEBHOOK_SECRET=

# --- Logs and errors ---
# DEBUG, INFO, WARNING or ERROR (empty: INFO)
LOG_LEVEL=
# DSN of the Sentry project (empty: nothing is sent)
SENTRY_DSN=
# Name shown in Sentry, e.g. openshift (empty: development)
SENTRY_ENVIRONMENT=

# --- Web page ---
# Address of the "Ask for one by email" link of the interface (empty: no link)
ACCESS_REQUEST_EMAIL=
# Addresses of the web interface when it is on another domain, comma-separated, e.g.
# https://pipefix.xulys.com,http://localhost:5173 (empty: same domain only)
CORS_ORIGINS=
